{
  "name": "neural-network-video",
  "version": "1.0.0",
  "private": true,
  "description": "A 10-minute Remotion film about how neural networks work — told as one continuous take.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/fetch-fonts.mjs",
    "train": "tsx scripts/train-digits.ts && tsx scripts/train-toys.ts && tsx scripts/train-cnn.ts",
    "train:toys": "tsx scripts/train-toys.ts",
    "train:cnn": "tsx scripts/train-cnn.ts",
    "fit:attention": "tsx scripts/fit-attention.ts",
    "score": "tsx scripts/make-score.ts && remotion ffmpeg -y -i out/score.wav -c:a aac -b:a 160k -ar 48000 -f mp4 -movflags +faststart public/audio/score.m4a",
    "qa": "node scripts/qa-stills.mjs",
    "render": "remotion render src/index.ts NeuralNetwork out/neural-network.mp4 --scale=1.5",
    "render:silent": "remotion render src/index.ts NeuralNetwork out/neural-network-silent.mp4 --scale=1.5 --props='{\"audio\":false}'",
    "render:draft": "remotion render src/index.ts NeuralNetwork out/draft.mp4 --scale=0.5 --crf=30 --props='{\"audio\":false}'"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/shapes": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "katex": "^0.16.22",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
